<DefaultWindow xmlns="https://spacestation14.io"
               Title="Підтвердження респавну"
               MinSize="450 200">
    
    <BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="15">
        
        <RichTextLabel Name="MessageLabel" MinHeight="75" HorizontalExpand="True" VerticalExpand="True" />
        
        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" SeparationOverride="30">
            <Button Name="ConfirmButton" Text="ТАК" MinWidth="100" StyleClasses="ButtonCaution" />
            <Button Name="CancelButton" Text="НІ" MinWidth="100" />
        </BoxContainer>
        
    </BoxContainer>
    
</DefaultWindow>
